+  SHA=$(git rev-parse HEAD)
+  # Plain push to our own work branch (IaC #35, final): never force, never dev. A refused commit is dropped by a revert, never a rewrite.
+  PUSH=(git -c push.negotiate=true push -q origin "HEAD:refs/heads/work/$AGENT")
